# OptiDrive local/Docker configuration
# Copy to .env and fill only the keys you want to activate.

GOOGLE_MAPS_API_KEY=
OPEN_CHARGE_MAP_API_KEY=

# Google Cloud Console OAuth web client
# Authorized redirect URIs:
# - http://localhost:5080/signin-google
# - http://localhost:5088/signin-google
# - https://optidrive-d0dmcjfkhwebgtb3.westeurope-01.azurewebsites.net/signin-google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Entra ID / Microsoft Account OAuth app
# Redirect URIs:
# - http://localhost:5080/signin-microsoft
# - http://localhost:5088/signin-microsoft
# - https://optidrive-d0dmcjfkhwebgtb3.westeurope-01.azurewebsites.net/signin-microsoft
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Optional Sign in with Apple placeholder
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=

# Atlassian Confluence/Jira publishing helpers; never commit the real token.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=OptiDrive
