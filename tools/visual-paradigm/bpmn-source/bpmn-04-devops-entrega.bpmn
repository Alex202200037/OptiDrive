<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_DevOps" targetNamespace="https://optidrive.local/bpmn/devops" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Process_DevOps" name="bpmn-04-devops-entrega" isExecutable="false">
    <bpmn:startEvent id="devops_start" name="Necessidade de publicar entrega">
      <bpmn:outgoing>devops_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="devops_prepare" name="Preparar configuração local e Azure">
      <bpmn:incoming>devops_f1</bpmn:incoming>
      <bpmn:outgoing>devops_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="devops_build" name="Executar build, testes e validação">
      <bpmn:incoming>devops_f2</bpmn:incoming>
      <bpmn:incoming>devops_f9</bpmn:incoming>
      <bpmn:outgoing>devops_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="devops_ok" name="Build e testes OK?">
      <bpmn:incoming>devops_f3</bpmn:incoming>
      <bpmn:outgoing>devops_f4</bpmn:outgoing>
      <bpmn:outgoing>devops_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="devops_deploy" name="Publicar aplicação e atualizar documentação">
      <bpmn:incoming>devops_f4</bpmn:incoming>
      <bpmn:outgoing>devops_f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="devops_health" name="Verificar healthcheck, admin e métricas">
      <bpmn:incoming>devops_f5</bpmn:incoming>
      <bpmn:outgoing>devops_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="devops_package" name="Gerar pacote final de entrega">
      <bpmn:incoming>devops_f6</bpmn:incoming>
      <bpmn:outgoing>devops_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="devops_end" name="Entrega validada">
      <bpmn:incoming>devops_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="devops_fix" name="Corrigir defeitos e repetir validação">
      <bpmn:incoming>devops_f8</bpmn:incoming>
      <bpmn:outgoing>devops_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="devops_f1" sourceRef="devops_start" targetRef="devops_prepare" />
    <bpmn:sequenceFlow id="devops_f2" sourceRef="devops_prepare" targetRef="devops_build" />
    <bpmn:sequenceFlow id="devops_f3" sourceRef="devops_build" targetRef="devops_ok" />
    <bpmn:sequenceFlow id="devops_f4" name="sim" sourceRef="devops_ok" targetRef="devops_deploy" />
    <bpmn:sequenceFlow id="devops_f5" sourceRef="devops_deploy" targetRef="devops_health" />
    <bpmn:sequenceFlow id="devops_f6" sourceRef="devops_health" targetRef="devops_package" />
    <bpmn:sequenceFlow id="devops_f7" sourceRef="devops_package" targetRef="devops_end" />
    <bpmn:sequenceFlow id="devops_f8" name="não" sourceRef="devops_ok" targetRef="devops_fix" />
    <bpmn:sequenceFlow id="devops_f9" sourceRef="devops_fix" targetRef="devops_build" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="bpmn-04-devops-entrega_diagram" name="bpmn-04-devops-entrega">
    <bpmndi:BPMNPlane id="bpmn-04-devops-entrega_plane" bpmnElement="Process_DevOps">
      <bpmndi:BPMNShape id="devops_start_di" bpmnElement="devops_start">
        <dc:Bounds x="60" y="197" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_prepare_di" bpmnElement="devops_prepare">
        <dc:Bounds x="150" y="170" width="280" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_build_di" bpmnElement="devops_build">
        <dc:Bounds x="500" y="170" width="270" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_ok_di" bpmnElement="devops_ok">
        <dc:Bounds x="840" y="184" width="82" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_deploy_di" bpmnElement="devops_deploy">
        <dc:Bounds x="990" y="170" width="300" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_health_di" bpmnElement="devops_health">
        <dc:Bounds x="1360" y="170" width="280" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_package_di" bpmnElement="devops_package">
        <dc:Bounds x="1710" y="170" width="260" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_end_di" bpmnElement="devops_end">
        <dc:Bounds x="2040" y="197" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="devops_fix_di" bpmnElement="devops_fix">
        <dc:Bounds x="500" y="420" width="270" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="devops_f1_di" bpmnElement="devops_f1">
        <di:waypoint x="116.0" y="225.0" />
        <di:waypoint x="150.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f2_di" bpmnElement="devops_f2">
        <di:waypoint x="430.0" y="225.0" />
        <di:waypoint x="500.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f3_di" bpmnElement="devops_f3">
        <di:waypoint x="770.0" y="225.0" />
        <di:waypoint x="840.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f4_di" bpmnElement="devops_f4">
        <di:waypoint x="922.0" y="225.0" />
        <di:waypoint x="990.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f5_di" bpmnElement="devops_f5">
        <di:waypoint x="1290.0" y="225.0" />
        <di:waypoint x="1360.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f6_di" bpmnElement="devops_f6">
        <di:waypoint x="1640.0" y="225.0" />
        <di:waypoint x="1710.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f7_di" bpmnElement="devops_f7">
        <di:waypoint x="1970.0" y="225.0" />
        <di:waypoint x="2040.0" y="225.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f8_di" bpmnElement="devops_f8">
        <di:waypoint x="881.0" y="266.0" />
        <di:waypoint x="881.0" y="355.0" />
        <di:waypoint x="635.0" y="355.0" />
        <di:waypoint x="635.0" y="420.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="devops_f9_di" bpmnElement="devops_f9">
        <di:waypoint x="635.0" y="420.0" />
        <di:waypoint x="635.0" y="280.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>