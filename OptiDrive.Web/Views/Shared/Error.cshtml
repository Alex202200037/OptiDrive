@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<section class="auth-wrap">
    <div class="auth-card auth-card--light">
        <p class="eyebrow">OptiDrive</p>
        <h1>Algo correu mal</h1>
        <p class="text-muted-custom">Não foi possível concluir o pedido. Tenta novamente dentro de momentos.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted-custom"><strong>Referência:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-brand mt-3" asp-controller="Home" asp-action="Index">Voltar ao início</a>
    </div>
</section>
