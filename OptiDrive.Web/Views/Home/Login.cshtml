@model OptiDrive.Web.Models.LoginInputModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="auth-wrap">
    <div class="auth-card">
        <p class="eyebrow">OptiDrive</p>
        <h1>Entrar</h1>
        <p class="text-muted-custom">Acede à tua conta para gerir veiculos, viagens, custos e contactos.</p>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mt-4">@error</div>
        }
        @if (ViewBag.GoogleAuthEnabled == true || ViewBag.MicrosoftAuthEnabled == true || ViewBag.AppleSignInVisible == true)
        {
            <div class="oauth-grid mt-4">
                @if (ViewBag.GoogleAuthEnabled == true)
                {
                    <form asp-action="LoginWithGoogle" method="post">
                        <button type="submit" class="btn btn-google w-100">Entrar com Google</button>
                    </form>
                }
                @if (ViewBag.AppleSignInVisible == true)
                {
                    <form asp-action="LoginWithApple" method="post">
                        <button type="submit" class="btn btn-apple w-100">Entrar com Apple</button>
                    </form>
                }
                @if (ViewBag.MicrosoftAuthEnabled == true)
                {
                    <form asp-action="LoginWithMicrosoft" method="post">
                        <button type="submit" class="btn btn-microsoft w-100">Entrar com Microsoft</button>
                    </form>
                }
            </div>
            <div class="auth-separator"><span>ou</span></div>
        }
        <form asp-action="Login" method="post" class="mt-4">
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control app-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control app-control" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Aceder ao cockpit</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
