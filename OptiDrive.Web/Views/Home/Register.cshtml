@model OptiDrive.Web.Models.RegisterInputModel
@{
    ViewData["Title"] = "Registar";
}

<section class="auth-wrap">
    <div class="auth-card auth-card--light">
        <p class="eyebrow">Nova conta</p>
        <h1>Criar perfil</h1>
        <p class="text-muted-custom">Cria a tua conta para começar a gerir veículos, rotas, custos e viagens partilhadas.</p>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mt-4">@error</div>
        }
        @if (ViewBag.GoogleAuthEnabled == true || ViewBag.AppleSignInVisible == true || ViewBag.MicrosoftAuthEnabled == true)
        {
            <div class="oauth-grid mt-4">
                @if (ViewBag.GoogleAuthEnabled == true)
                {
                    <form asp-action="LoginWithGoogle" method="post">
                        <button type="submit" class="btn btn-google w-100">Criar com Google</button>
                    </form>
                }
                @if (ViewBag.AppleSignInVisible == true)
                {
                    <form asp-action="LoginWithApple" method="post">
                        <button type="submit" class="btn btn-apple w-100">Criar com Apple</button>
                    </form>
                }
                @if (ViewBag.MicrosoftAuthEnabled == true)
                {
                    <form asp-action="LoginWithMicrosoft" method="post">
                        <button type="submit" class="btn btn-microsoft w-100">Criar com Microsoft</button>
                    </form>
                }
            </div>
            <div class="auth-separator auth-separator--light"><span>ou criar com email</span></div>
        }
        <form asp-action="Register" method="post" class="mt-4">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control app-control app-control--light" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control app-control app-control--light" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control app-control app-control--light" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Criar conta e entrar</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
