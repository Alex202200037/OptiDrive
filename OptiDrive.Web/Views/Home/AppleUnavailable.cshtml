@{
    ViewData["Title"] = "Apple indisponível";
}

<section class="auth-wrap">
    <div class="auth-card auth-card--light auth-card--secure">
        <p class="eyebrow">Sign in with Apple</p>
        <h1>Apple ainda não está disponível neste ambiente</h1>
        <p class="text-muted-custom">
            Pedimos desculpa, mas o acesso com Apple exige validação adicional no Apple Developer Program e
            configuração HTTPS pública. Neste momento podes entrar com Google, email e palavra-passe, ou ativar
            Authenticator para reforçar a segurança da conta.
        </p>
        <div class="mini-panel mt-4">
            <strong>Estado</strong>
            <p class="text-soft mt-2 mb-0">
                A integração está preparada tecnicamente, mas não está ativa para este ambiente de apresentação.
            </p>
        </div>
        <div class="d-grid gap-3 mt-4">
            <a class="btn btn-brand" asp-controller="Home" asp-action="Login">Voltar ao login</a>
            <a class="btn btn-ghost-dark" asp-controller="Home" asp-action="Register">Criar conta com email</a>
        </div>
    </div>
</section>
