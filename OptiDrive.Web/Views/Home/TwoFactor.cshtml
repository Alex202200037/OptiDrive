@model OptiDrive.Web.Models.TwoFactorInputModel
@{
    ViewData["Title"] = "Verificacao em dois passos";
}

<section class="auth-wrap">
    <div class="auth-card auth-card--secure">
        <p class="eyebrow">Seguranca</p>
        <h1>Confirma o codigo</h1>
        <p class="text-muted-custom">Abre o Microsoft Authenticator, Google Authenticator ou usa um codigo de recuperacao.</p>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mt-4">@error</div>
        }
        <form asp-action="TwoFactor" method="post" class="mt-4">
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control app-control code-control" inputmode="numeric" autocomplete="one-time-code" placeholder="123 456" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Validar e entrar</button>
        </form>
        <a asp-action="Login" class="auth-backlink">Voltar ao login</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
