@model DashboardViewModel
@{
    ViewData["Title"] = "Perfil";
    var defaultVehicle = Model.Vehicles.FirstOrDefault(vehicle => vehicle.IsDefault) ?? Model.Vehicles.FirstOrDefault();
    var recoveryCodes = (TempData["RecoveryCodes"] as string)?.Split(';', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    string roleLabel(UserRole role) => role == UserRole.Admin ? "Administrador" : "Condutor";
    string fuelLabel(FuelKind kind) => kind switch
    {
        FuelKind.Gasoline95 => "Gasolina 95",
        FuelKind.Gasoline98 => "Gasolina 98",
        FuelKind.Diesel => "Gasóleo",
        FuelKind.GPL => "GPL",
        FuelKind.Electric => "Elétrico",
        _ => kind.ToString()
    };
    string tollLabel(TollClass tollClass) => $"Classe {(int)tollClass + 1}";
}

<section class="page-hero">
    <div>
        <p class="eyebrow">Perfil</p>
        <h1>@Model.User.Name</h1>
        <p class="text-soft">A tua visão geral de conta, garagem principal, sincronizações e acesso rápido ao resto do sistema.</p>
    </div>
    <div class="hero-actions">
        <span class="mini-pill">@Model.User.Email</span>
        <span class="mini-pill">Perfil privado</span>
        <span class="mini-pill">MFA: @(Model.User.TwoFactorEnabled ? "Ativo" : "Pendente")</span>
        <span class="mini-pill">Perfil: @roleLabel(Model.User.Role)</span>
        <form asp-controller="Home" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-ghost">Terminar sessão</button>
        </form>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success mt-4" role="status" aria-live="polite">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger mt-4" role="alert">@error</div>
}

<section class="profile-layout">
    <article class="panel-card profile-card">
        @if (!string.IsNullOrWhiteSpace(Model.User.AvatarUrl))
        {
            <img class="profile-photo" src="@Model.User.AvatarUrl" alt="@Model.User.Name" />
        }
        else
        {
            <div class="profile-avatar">@string.Concat(Model.User.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0]).Take(2))</div>
        }
        <div>
            <p class="eyebrow">Conta</p>
            <h2>@Model.User.Name</h2>
            <p class="text-soft">@Model.User.Email</p>
            <p class="text-soft">@Model.SocialProfile.Bio</p>
        </div>
        <div class="profile-stats">
            <div><span>Veículos</span><strong>@Model.Vehicles.Count</strong></div>
            <div><span>Rotas</span><strong>@Model.Routes.Count</strong></div>
            <div><span>Contactos</span><strong>@Model.Contacts.Count</strong></div>
            <div><span>Viagens sociais</span><strong>@Model.CollaborativeTrips.Count</strong></div>
        </div>
    </article>

    <article class="panel-card">
        <div class="panel-top">
            <div>
                <p class="eyebrow">Veículo ativo</p>
                <h2>@(defaultVehicle?.Nickname ?? "Sem veículo definido")</h2>
            </div>
            @if (defaultVehicle is not null)
            {
                <a class="btn btn-ghost-dark" asp-controller="Garage" asp-action="Index">Gerir garagem</a>
            }
        </div>
        @if (defaultVehicle is not null)
        {
            <div class="vehicle-spotlight">
                <div class="vehicle-illustration">
                    <div class="vehicle-shape">
                        <span>@defaultVehicle.Brand</span>
                    </div>
                </div>
                <div class="vehicle-copy">
                    <h3>@defaultVehicle.Brand @defaultVehicle.Model</h3>
                    <p>@defaultVehicle.Year · @fuelLabel(defaultVehicle.FuelKind) · autonomia @defaultVehicle.AverageRangeKm km</p>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <span class="mini-pill">Nível @defaultVehicle.CurrentLevelPercent%</span>
                        <span class="mini-pill">Consumo @defaultVehicle.AverageConsumption</span>
                        <span class="mini-pill">@tollLabel(defaultVehicle.TollClass)</span>
                    </div>
                </div>
            </div>
        }
    </article>
</section>

<section class="security-grid mt-4">
    <article class="panel-card security-card">
        <div class="panel-top">
            <div>
                <p class="eyebrow">Conta real</p>
                <h2>Seguranca e login</h2>
            </div>
            <span class="mini-pill @(Model.User.TwoFactorEnabled ? "mini-pill--ok" : "mini-pill--warn")">
                @(Model.User.TwoFactorEnabled ? "2FA ligado" : "2FA recomendado")
            </span>
        </div>
        <div class="security-metrics">
            <div><span>Identidade</span><strong>Privada</strong></div>
            <div><span>Email</span><strong>@(Model.User.EmailConfirmed ? "Confirmado" : "Por confirmar")</strong></div>
            <div><span>Login externo</span><strong>@((Model.GoogleAuthEnabled || Model.MicrosoftAuthEnabled || Model.AppleAuthEnabled) ? "Disponível" : "Config pendente")</strong></div>
            <div><span>2FA</span><strong>@(Model.User.TwoFactorEnabled ? "Ativo" : "Recomendado")</strong></div>
        </div>
        <p class="text-soft mt-3">A autenticação usa password hashing PBKDF2, bloqueio por tentativas e autenticação em dois passos compatível com Microsoft Authenticator, Google Authenticator e apps TOTP equivalentes.</p>
    </article>

    <article class="panel-card authenticator-card">
        <div class="panel-top">
            <div>
                <p class="eyebrow">Microsoft Authenticator</p>
                <h2>@(Model.User.TwoFactorEnabled ? "Conta protegida" : "Ativar 2FA")</h2>
            </div>
        </div>
        @if (!Model.User.TwoFactorEnabled)
        {
            <div class="authenticator-setup">
                @if (!string.IsNullOrWhiteSpace(Model.AuthenticatorSetup.QrCodeDataUri))
                {
                    <img src="@Model.AuthenticatorSetup.QrCodeDataUri" alt="QR code para Authenticator" />
                }
                <div>
                    <p class="text-soft">Digitaliza o QR code no Microsoft Authenticator ou Google Authenticator e introduz o codigo gerado.</p>
                    <code>@Model.AuthenticatorSetup.SharedKey</code>
                    <form asp-controller="Profile" asp-action="EnableAuthenticator" method="post" class="mt-3">
                        <label class="visually-hidden" for="AuthenticatorCode">Código de seis dígitos</label>
                        <input name="Code" id="AuthenticatorCode" class="form-control app-control app-control--light code-control" inputmode="numeric" autocomplete="one-time-code" placeholder="Código de 6 dígitos" />
                        <button type="submit" class="btn btn-brand mt-3">Ativar 2FA</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <p class="text-soft">A conta exige um segundo fator no login. Tens @Model.AuthenticatorSetup.RecoveryCodeCount codigos de recuperacao disponiveis.</p>
            <div class="security-actions">
                <form asp-controller="Profile" asp-action="RegenerateRecoveryCodes" method="post" data-confirm="Gerar novos códigos? Os códigos de recuperação anteriores deixarão de funcionar.">
                    <button type="submit" class="btn btn-ghost-dark">Gerar novos codigos</button>
                </form>
                <form asp-controller="Profile" asp-action="ResetAuthenticator" method="post" data-confirm="Reconfigurar o Authenticator desta conta?">
                    <button type="submit" class="btn btn-ghost-dark">Reconfigurar app</button>
                </form>
                <form asp-controller="Profile" asp-action="DisableAuthenticator" method="post" data-confirm="Desativar a autenticação em dois passos?">
                    <button type="submit" class="btn btn-danger-soft">Desativar 2FA</button>
                </form>
            </div>
        }
        @if (recoveryCodes.Length > 0)
        {
            <div class="recovery-box mt-4">
                <p class="eyebrow">Guardar agora</p>
                <h3>Codigos de recuperacao</h3>
                <div class="recovery-grid">
                    @foreach (var code in recoveryCodes)
                    {
                        <code>@code</code>
                    }
                </div>
            </div>
        }
    </article>
</section>

<section class="social-command mt-4">
    <article class="panel-card">
        <p class="eyebrow">Identidade social</p>
        <h2>@Model.SocialProfile.DisplayName</h2>
        <div class="profile-stats mt-3">
            <div><span>Cidade</span><strong>@(string.IsNullOrWhiteSpace(Model.SocialProfile.HomeCity) ? "N/D" : Model.SocialProfile.HomeCity)</strong></div>
            <div><span>Estilo</span><strong>@Model.SocialProfile.DrivingStyle</strong></div>
            <div><span>Boleia</span><strong>@(Model.SocialProfile.IsOpenToCarpool ? "Sim" : "Não")</strong></div>
            <div><span>Live trip</span><strong>@(Model.SocialProfile.ShareLiveTripStatus ? "Sim" : "Não")</strong></div>
        </div>
        <a class="btn btn-brand mt-3" asp-controller="Social" asp-action="Index">Abrir rede social</a>
    </article>
    <article class="panel-card">
        <p class="eyebrow">Mensagens recentes</p>
        <h2>Conversas</h2>
        <div class="message-thread message-thread--compact mt-3">
            @foreach (var message in Model.DirectMessages.Take(3))
            {
                <div class="message-bubble @(message.SenderUserId == Model.User.Id ? "message-bubble--mine" : "")">
                    <strong>@message.SenderName</strong>
                    <p>@message.Body</p>
                </div>
            }
        </div>
    </article>
</section>

<section class="sync-grid">
    @foreach (var item in Model.SyncStatuses)
    {
        <article class="sync-card @(item.Value.IsSuccess ? "sync-card--ok" : "sync-card--warn")">
            <p class="eyebrow">@item.Value.SourceName</p>
            <h3>@item.Key</h3>
            <p>@item.Value.Message</p>
            <small>@(item.Value.LastSuccessUtc?.ToLocalTime().ToString("g") ?? "Sem sucesso ainda") · @item.Value.ItemCount itens</small>
        </article>
    }
</section>

<section class="feature-grid mt-4">
    @if (Model.User.Role != UserRole.Admin)
    {
        <a class="feature-link-card" asp-controller="Garage" asp-action="Index">
            <p class="eyebrow">Garagem</p>
            <h3>Editar carros e definir viatura ativa</h3>
        </a>
        <a class="feature-link-card" asp-controller="Planning" asp-action="Index">
            <p class="eyebrow">Planeamento</p>
            <h3>Mapa, postos, rotas e Smart Save</h3>
        </a>
    }
    <a class="feature-link-card" asp-controller="Social" asp-action="Index">
        <p class="eyebrow">Social</p>
        <h3>Contactos, partilhas e grupos de viagem</h3>
    </a>
    @if (Model.User.Role == UserRole.Admin)
    {
        <a class="feature-link-card" asp-controller="Admin" asp-action="Index">
            <p class="eyebrow">Backoffice</p>
            <h3>Estado das integrações e controlo da plataforma</h3>
        </a>
    }
</section>
